{
    "name": "laranail/crm-tools-vtiger-client",
    "license": "MIT",
    "description": "A Vtiger web-services client for Laravel.",
    "homepage": "https://opensource.simtabi.com/products/laranail/crm-tools-vtiger-client",
    "type": "library",
    "keywords": [
        "VtWsClient",
        "webservices",
        "vtiger",
        "api client",
        "vtiger api"
    ],
    "authors": [
        {
            "name": "Imani Manyara",
            "email": "imani@simtabi.com"
        }
    ],
    "require": {
        "php": "^8.4.1 || ^8.5",
        "adbario/php-dot-notation": "^3.3",
        "guzzlehttp/guzzle": "^7.8",
        "illuminate/support": "^13.0",
        "laranail/package-tools": "^0.1",
        "laranail/toolkit": "^0.1",
        "simtabi/pheg": "dev-master"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^11.1",
        "pestphp/pest": "^4.6"
    },
    "autoload": {
        "psr-4": {
            "Simtabi\\Laranail\\CrmTools\\VtigerClient\\": "src/"
        },
        "files": [
            "helpers/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Simtabi\\Laranail\\CrmTools\\VtigerClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Simtabi\\Laranail\\CrmTools\\VtigerClient\\Providers\\VtWsClientServiceProvider"
            ],
            "aliases": {
                "VtWsClient": "Simtabi\\Laranail\\CrmTools\\VtigerClient\\Facades\\VtWsClientFacade"
            }
        },
        "branch-alias": {
            "dev-main": "0.1.x-dev"
        }
    },
    "scripts": {
        "docs": [
            "@install-pip",
            "@install-pip-reqs",
            "cd ./docs && make html"
        ],
        "install-pip": "! hash pip &> /dev/null && sudo apt install -qy python-pip",
        "install-pip-reqs": "pip install -r ./docs/pip-requirements.txt",
        "pint": "vendor/bin/pint --test --config vendor/laranail/package-tools/pint.json",
        "pint-fix": "vendor/bin/pint --parallel --config vendor/laranail/package-tools/pint.json",
        "format": "@pint-fix",
        "lint": [
            "@pint"
        ]
    },
    "support": {
        "issues": "https://github.com/laranail/crm-tools-vtiger-client/issues",
        "source": "https://github.com/laranail/crm-tools-vtiger-client",
        "docs": "https://opensource.simtabi.com/documentation/laranail/crm-tools-vtiger-client/"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/laranail/package-tools"
        },
        {
            "type": "vcs",
            "url": "https://github.com/simtabi/pheg"
        },
        {
            "type": "vcs",
            "url": "https://github.com/simtabi/json-objects"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/toolkit"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laranail/console"
        }
    ],
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
